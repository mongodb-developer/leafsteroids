@using website.Data
@inject IJSRuntime JS

<div id="@ElementId" class="leaf-heat"></div>

<style>
    .leaf-heat {
        width: 440px;
        height: 480px;
        margin: 12px auto;
        background: #fff;
        border-radius: 2px;
        box-shadow: 0 2px 10px 0 rgba(70, 76, 79, .2);
    }
</style>

@code {
    [Parameter, EditorRequired] public string ElementId { get; set; } = "";
    [Parameter] public List<HeatmapPoint> Points { get; set; } = new();

    private bool _drawn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_drawn) return;
        _drawn = true;
        await JS.InvokeVoidAsync("leafsteroidsCharts.heatmap", ElementId, Points);
    }
}
